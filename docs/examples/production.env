# A full Bioconductor release build that publishes to object storage, as used
# for webr.bioconductor.org. Copy to the repository root as .env; see
# docs/operations.md.

BIOC_VERSION=3.23

# Empty for a full release.
BIOC_PACKAGES=

OUT_DIR=./out
HOST_UID=1000
HOST_GID=1000

# Bioconductor 3.23 and 3.24 need an R 4.6 webR; see docs/updating.md.
WEBR_VERSION=v0.6.0
CRAN_URL=https://cloud.r-project.org

# Set from the previous release: 3.22 published 2136 binaries.
MIN_PACKAGES=2100

# The `js2` remote is defined in rclone.conf; the hosting templates in deploy/
# read releases from the same remote and path.
RCLONE_REMOTE=js2:/webr
# Site-specific. Absolute path to the directory holding rclone.conf.
RCLONE_CONFIG_DIR=/etc/bioc-webr/rclone
RCLONE_VERSION=1.71
