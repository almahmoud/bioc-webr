# Copy to .env and edit. Docker Compose reads .env automatically.
#
#   cp .env.example .env
#   docker compose run --rm build
#
# See docs/development.md for the development workflow and
# docs/operations.md for what to change at each Bioconductor release.

# ----------------------------------------------------------------- required
# The Bioconductor release to build; the source repository URL is derived
# from it.
BIOC_VERSION=3.23

# ----------------------------------------------------------- development
# Build ONLY these packages and their hard dependencies. Space or comma
# separated Bioconductor package names. A full release takes hours; a small
# subset takes minutes. The output is marked INCOMPLETE and publish.sh
# refuses to publish it. Leave EMPTY for a real build.
#BIOC_PACKAGES=BiocGenerics S4Vectors IRanges

# Regular expression of package names to exclude from a full build. Record
# why in docs/operations.md.
#BIOC_SKIP_REGEX=^(SomeBrokenPkg|AnotherOne)$

# ------------------------------------------------------------------- build
# R's Ncpus option in the build driver, used when it installs its own
# dependencies. rwasm compiles packages one at a time.
BUILD_JOBS=2

# Where build output goes. One subdirectory per Bioconductor version.
OUT_DIR=./out

# Ownership restored on the output before the container exits, so the build
# artifacts are not left owned by root.
#   Linux/macOS:  HOST_UID=$(id -u)  HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------- versions
# The webR release. A webR release fixes the ABI of every .wasm it produces;
# a browser running webR X is not guaranteed to load packages built by webR Y.
# See docs/operations.md before changing it.
WEBR_VERSION=v0.6.0

# Overridden only when building against a staging or mirror repository.
#BIOC_REPO_URL=https://bioconductor.org/packages/3.23/bioc/

# Mirror used for the build driver's own dependencies. Not what gets
# cross-compiled.
CRAN_URL=https://cloud.r-project.org

# rwasm ships in the webR image from v0.6.0; only used when WEBR_VERSION is
# pinned to an older image.
RWASM_REF=r-wasm/rwasm

# ----------------------------------------------------------------- publish
# Only needed by scripts/publish.sh.
#
# rclone remote and path. Publishing uses `rclone sync`, which DELETES remote
# files absent locally; publish.sh validates the build first. Do not invoke
# the publish service directly.
#RCLONE_REMOTE=js2:/webr

# Absolute path to the directory containing rclone.conf. Must be absolute -
# Compose does not expand `~`.
#RCLONE_CONFIG_DIR=/home/you/.config/rclone

RCLONE_VERSION=1.71

# Minimum binary package count before publish.sh will proceed. Set from the
# previous release's count.
MIN_PACKAGES=500

# ------------------------------------------------------------------- serve
SERVE_PORT=8080
NGINX_VERSION=1.29-alpine
